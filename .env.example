# Copy to .env and adjust. Never commit .env.
DATABASE_URL=postgresql+psycopg://disruption:disruption@localhost:5432/disruption
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Comma-separated SHA-256 hashes of the accepted API keys (never store the keys themselves).
# Generate a key and its hash with:  python -m disruption_api.auth
API_KEY_HASHES=
